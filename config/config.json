{
    "title": "Linear Algebra",
    "author": "Akizumi",
    "output": {
        "html": "_build/html",
        "pdf": "_build/pdf",
        "book": "_build/pdf/book.pdf"
    },
    "environment_settings": {
        "big_envs": [
            {
                "prefix": "thm",
                "name": "Theorem",
                "numbered": true,
                "counter_group": "main",
                "color": "#2f62b5"
            },
            {
                "prefix": "lem",
                "name": "Lemma",
                "numbered": true,
                "counter_group": "main",
                "color": "#2f62b5"
            },
            {
                "prefix": "cor",
                "name": "Corollary",
                "numbered": true,
                "counter_group": "main",
                "color": "#2f62b5"
            },
            {
                "prefix": "prp",
                "name": "Proposition",
                "numbered": true,
                "counter_group": "main",
                "color": "#2f62b5"
            },
            {
                "prefix": "cnj",
                "name": "Conjecture",
                "numbered": false,
                "color": "#6b6f7a"
            },
            {
                "prefix": "def",
                "name": "Definition",
                "numbered": true,
                "counter_group": "definition",
                "color": "#b0414f"
            },
            {
                "prefix": "exm",
                "name": "Example",
                "numbered": false,
                "color": "#3b7a4c"
            },
            {
                "prefix": "exr",
                "name": "Exercise",
                "numbered": false,
                "color": "#a8670c"
            }
        ],
        "small_envs": [
            "remark",
            "proof",
            "solution",
            "claim",
            "proofofclaim",
            "algorithm",
            "idea",
            "warning",
            "check"
        ]
    },
    "chapters": [
        {
            "dir": "src/ch00-foundations",
            "part": "Part I · Spaces and Maps"
        },
        "src/ch01-vector-spaces",
        "src/ch02-linear-systems",
        "src/ch03-linear-maps",
        "src/ch04-duality",
        {
            "dir": "src/ch05-polynomials",
            "part": "Part II · Determinants and the Structure of Operators"
        },
        "src/ch06-determinants",
        "src/ch07-block-matrices",
        "src/ch08-eigenvalues",
        "src/ch09-canonical-forms",
        {
            "dir": "src/ch10-inner-products",
            "part": "Part III \u00b7 Inner Products and Spectral Theory"
        },
        "src/ch11-spectral-theory",
        "src/ch12-psd-and-svd",
        {
            "dir": "src/ch13-forms",
            "part": "Part IV \u00b7 Forms and Multilinear Algebra"
        },
        "src/ch14-tensors",
        {
            "dir": "src/ch15-norms",
            "part": "Part V \u00b7 Matrix Analysis"
        },
        "src/ch16-variational",
        "src/ch17-convexity"
    ],
    "macros": "latex/macros.tex",
    "templates": {
        "html": "templates/html/template.html",
        "latex": "templates/latex/template.tex"
    },
    "styles": {
        "html": "templates/html/styles.css",
        "latex": "latex/latex-template.sty"
    },
    "deploy-dir": "site",
    "deploy-repo": "https://github.com/AkizumiFox/linear-algebra.git",
    "deploy-domain": "linear-algebra.akizumifox.com",
    "deploy-push-url": "git@github.com:AkizumiFox/linear-algebra.git",
    "issues-url": "https://github.com/AkizumiFox/linear-algebra/issues/new",
    "redirects": {
        "ch02-linear-transformations/01-linear-transformations.html": "ch03-linear-maps/01-linear-maps.html",
        "ch03-linear-maps/01-linear-transformations.html": "ch03-linear-maps/01-linear-maps.html",
        "ch02-linear-transformations/": "ch03-linear-maps/"
    }
}
