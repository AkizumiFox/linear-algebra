{
  "title": "Linear Algebra",
  "author": "Akizumi",
  "output": {
    "html": "_build/html",
    "pdf": "_build/pdf",
    "book": "_build/pdf/book.pdf"
  },
  "environment_settings": {
    "big_envs": [
      {
        "prefix": "thm",
        "name": "Theorem",
        "numbered": true,
        "counter_group": "main",
        "color": "#2f62b5"
      },
      {
        "prefix": "lem",
        "name": "Lemma",
        "numbered": true,
        "counter_group": "main",
        "color": "#2f62b5"
      },
      {
        "prefix": "cor",
        "name": "Corollary",
        "numbered": true,
        "counter_group": "main",
        "color": "#2f62b5"
      },
      {
        "prefix": "prp",
        "name": "Proposition",
        "numbered": true,
        "counter_group": "main",
        "color": "#2f62b5"
      },
      {
        "prefix": "cnj",
        "name": "Conjecture",
        "numbered": false,
        "color": "#6b6f7a"
      },
      {
        "prefix": "def",
        "name": "Definition",
        "numbered": true,
        "counter_group": "definition",
        "color": "#b0414f"
      },
      {
        "prefix": "exm",
        "name": "Example",
        "numbered": false,
        "color": "#3b7a4c"
      },
      {
        "prefix": "exr",
        "name": "Exercise",
        "numbered": false,
        "color": "#a8670c"
      }
    ],
    "small_envs": [
      "remark",
      "proof",
      "solution",
      "claim",
      "proofofclaim",
      "algorithm",
      "idea",
      "warning",
      "check"
    ]
  },
  "reading-paths": [
    {
      "slug": "computer-science",
      "name": "Computer science and machine learning",
      "description": "The singular value decomposition and what is built on it: low-rank approximation, the pseudoinverse, principal components, graph Laplacians and PageRank.",
      "targets": [
        "ch13-psd-and-svd/10",
        "ch13-psd-and-svd/11",
        "ch19-nonnegative/08",
        "ch24-applied/10",
        "ch24-applied/11"
      ]
    },
    {
      "slug": "economics",
      "name": "Economics and econometrics",
      "description": "Least squares, definiteness and the second-derivative test, linear programming duality and matrix games, Markov chains, and the M-matrices behind an input-output model.",
      "targets": [
        "ch11-inner-products/04",
        "ch14-forms/06",
        "ch18-convexity/06",
        "ch18-convexity/07",
        "ch19-nonnegative/06",
        "ch19-nonnegative/09"
      ]
    },
    {
      "slug": "pure-mathematics",
      "name": "Pure mathematics and algebra",
      "description": "Canonical forms over an arbitrary field, quadratic forms and Witt's theorems, the exterior algebra, and the characters of a finite group.",
      "targets": [
        "ch10-canonical-forms/06",
        "ch10-canonical-forms/07",
        "ch14-forms/08",
        "ch15-tensors/10",
        "ch23-algebras/08"
      ]
    },
    {
      "slug": "optimization",
      "name": "Optimization and operations research",
      "description": "Least squares, separating hyperplanes, linear programming duality, polytopes and convex functions, the Loewner order, and conjugate gradients.",
      "targets": [
        "ch11-inner-products/04",
        "ch13-psd-and-svd/05",
        "ch18-convexity/06",
        "ch18-convexity/09",
        "ch18-convexity/11",
        "ch24-applied/07"
      ]
    },
    {
      "slug": "physics",
      "name": "Physics and quantum mechanics",
      "description": "The matrix exponential, the functional calculus of a normal operator, Minkowski space, tensor products in quantum mechanics, and the normal modes of a vibrating structure.",
      "targets": [
        "ch10-canonical-forms/09",
        "ch12-spectral-theory/08",
        "ch14-forms/11",
        "ch15-tensors/11",
        "ch24-applied/09"
      ]
    },
    {
      "slug": "signal-processing",
      "name": "Electrical engineering and signal processing",
      "description": "Orthogonal expansions, the QR factorization, circulants and the discrete Fourier transform, the singular value decomposition, conditioning, and the fast Fourier transform.",
      "targets": [
        "ch11-inner-products/08",
        "ch11-inner-products/09",
        "ch12-spectral-theory/09",
        "ch13-psd-and-svd/08",
        "ch16-norms/08",
        "ch24-applied/12"
      ]
    },
    {
      "slug": "statistics",
      "name": "Statistics",
      "description": "Least squares in theory and in floating point, Gram matrices, two quadratic forms diagonalized at once, and principal components.",
      "targets": [
        "ch11-inner-products/04",
        "ch13-psd-and-svd/03",
        "ch13-psd-and-svd/04",
        "ch24-applied/03",
        "ch24-applied/10"
      ]
    },
    {
      "slug": "graphics",
      "name": "Graphics and geometry",
      "description": "Signed volume and orientation, the shape of a rotation, the polar decomposition, Euclidean motions, projective transformations, quadrics, and line coordinates in space.",
      "targets": [
        "ch07-determinants/09",
        "ch12-spectral-theory/06",
        "ch13-psd-and-svd/09",
        "ch22-geometry/04",
        "ch22-geometry/05",
        "ch22-geometry/07",
        "ch22-geometry/10"
      ]
    },
    {
      "slug": "control",
      "name": "Control theory",
      "description": "The matrix exponential and linear differential equations, convergent and power-bounded matrices, the Sylvester and Lyapunov equations, the spectral radius, and Krylov subspaces.",
      "targets": [
        "ch10-canonical-forms/09",
        "ch10-canonical-forms/10",
        "ch12-spectral-theory/10",
        "ch16-norms/04",
        "ch24-applied/06"
      ]
    },
    {
      "slug": "coding-theory",
      "name": "Coding theory and cryptography",
      "description": "The algebra that codes and lattices are built from: changing the field, rank over a finite field, irreducible polynomials, the Chinese remainder theorem, and the Smith normal form.",
      "targets": [
        "ch01-vector-spaces/09",
        "ch03-linear-systems/05",
        "ch06-polynomials/03",
        "ch06-polynomials/06",
        "ch10-canonical-forms/07"
      ]
    }
  ],
  "chapters": [
    {
      "dir": "src/ch00-foundations",
