{
    "title": "Linear Algebra",
    "author": "Akizumi",
    "output": {
        "html": "_build/html",
        "pdf": "_build/pdf",
        "book": "_build/pdf/book.pdf"
    },
    "environment_settings": {
        "big_envs": [
            {
                "prefix": "thm",
                "name": "Theorem",
                "numbered": true,
                "counter_group": "main",
                "color": "#2f62b5"
            },
            {
                "prefix": "lem",
                "name": "Lemma",
                "numbered": true,
                "counter_group": "main",
                "color": "#2f62b5"
            },
            {
                "prefix": "cor",
                "name": "Corollary",
                "numbered": true,
                "counter_group": "main",
                "color": "#2f62b5"
            },
            {
                "prefix": "prp",
                "name": "Proposition",
                "numbered": true,
                "counter_group": "main",
                "color": "#2f62b5"
            },
            {
                "prefix": "cnj",
                "name": "Conjecture",
                "numbered": false,
                "color": "#6b6f7a"
            },
            {
                "prefix": "def",
                "name": "Definition",
                "numbered": true,
                "counter_group": "definition",
                "color": "#b0414f"
            },
            {
                "prefix": "exm",
                "name": "Example",
                "numbered": false,
                "color": "#3b7a4c"
            },
            {
                "prefix": "exr",
                "name": "Exercise",
                "numbered": false,
                "color": "#a8670c"
            }
        ],
        "small_envs": [
            "remark",
            "proof",
            "solution",
            "claim",
            "proofofclaim",
            "algorithm"
        ]
    },
    "chapters": [
        "src/ch00-foundations",
        "src/ch01-vector-spaces",
        "src/ch02-linear-transformations"
    ],
    "macros": "latex/macros.tex",
    "templates": {
        "html": "templates/html/template.html",
        "latex": "templates/latex/template.tex"
    },
    "styles": {
        "html": "templates/html/styles.css",
        "latex": "latex/latex-template.sty"
    },
    "deploy-dir": "site",
    "deploy-repo": "https://github.com/AkizumiFox/linear-algebra.git",
    "deploy-domain": "linear-algebra.akizumifox.com",
    "deploy-push-url": "git@github.com:AkizumiFox/linear-algebra.git"
}
