\"></mjx-c></mjx-mi></mjx-script></mjx-msub><mjx-mo class=\"mjx-n\" space=\"4\"><mjx-c class=\"mjx-c2208\"></mjx-c></mjx-mo><mjx-mi class=\"mjx-i\" space=\"4\"><mjx-c class=\"mjx-c1D439 TEX-I\"></mjx-c></mjx-mi><mjx-mo class=\"mjx-n\"><mjx-c class=\"mjx-c29\"></mjx-c></mjx-mo></mjx-math><mjx-assistive-mml unselectable=\"on\" display=\"block\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\" display=\"block\"><mrow data-mjx-texclass=\"ORD\"><mi mathvariant=\"bold\">v</mi></mrow><mo>=</mo><msub><mi>a</mi><mn>1</mn></msub><msub><mrow data-mjx-texclass=\"ORD\"><mi mathvariant=\"bold\">v</mi></mrow><mn>1</mn></msub><mo>+</mo><mo>⋯</mo><mo>+</mo><msub><mi>a</mi><mi>n</mi></msub><msub><mrow data-mjx-texclass=\"ORD\"><mi mathvariant=\"bold\">v</mi></mrow><mi>n</mi></msub><mstyle scriptlevel=\"0\"><mspace width=\"2em\"></mspace></mstyle><mo stretchy=\"false\">(</mo><msub><mi>a</mi><mn>1</mn></msub><mo>,</mo><mo>…</mo><mo>,</mo><msub><mi>a</mi><mi>n</mi></msub><mo>∈</mo><mi>F</mi><mo stretchy=\"false\">)</mo></math></mjx-assistive-mml></mjx-container></span> in <strong>exactly one</strong> way.</p>","file":"ch01-vector-spaces/05-basis.html"}